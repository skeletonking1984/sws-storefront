.DS_Store
**/.DS_Store

.shopify
dist/
.env
node_modules/
screenshots/

# Hero composite: raw widget captures + the full-res PNG master are source
# inputs, regenerate with `node hero/compose.mjs`. Only the .webp actually
# used on the site (app/assets/hero-widgets.webp) is committed.
hero/*.png
app/assets/hero-widgets.png
.env.x

# Blog hero pipeline: captures and renders are reproducible from the scripts.
blog-hero/widgets-raw/
blog-hero/out/

# Written by scripts/stamp-build.mjs on every build. Never committed: a stamp
# read out of git rather than out of the running deployment is the fiction it
# exists to end.
app/data/build-info.json

# Intermediate PNG frames from hero/record.mjs. 510 of them, ~600MB, and
# regenerable by rerunning the script. The encoded mp4/webm are the artifact.
hero/.frames/

# Throwaway probe scripts. A stray one at the repo root fails the Oxygen
# deploy's "Uncommitted changes detected" guard, and on 2026-09-22 that refused
# a production deploy twice in three minutes. The author was not a person: the
# sws-daily-code-review scheduled task runs in this same working tree and had
# dropped SIX scratch files at the root between 20:14 and 20:17 while Todd was
# trying to deploy.
#
# The pattern is `*.tmp.*`, not `*.tmp.mjs`, because the first version of this
# rule shipped as `*.tmp.mjs` and the very next deploy attempt died on
# `highlights-test.tmp.mjs.bak`. Match the whole class or lose the race with a
# concurrent agent.
#
# Name any scratch file *.tmp.<anything> and it stays out of a deploy's way.
*.tmp.*
