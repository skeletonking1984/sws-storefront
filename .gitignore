.DS_Store
**/.DS_Store

.shopify
dist/
.env
node_modules/
screenshots/

# Hero composite: raw widget captures + the full-res PNG master are source
# inputs, regenerate with `node hero/compose.mjs`. Only the .webp actually
# used on the site (app/assets/hero-widgets.webp) is committed.
hero/*.png
app/assets/hero-widgets.png
.env.x

# Blog hero pipeline: captures and renders are reproducible from the scripts.
blog-hero/widgets-raw/
blog-hero/out/

# Written by scripts/stamp-build.mjs on every build. Never committed: a stamp
# read out of git rather than out of the running deployment is the fiction it
# exists to end.
app/data/build-info.json

# Intermediate PNG frames from hero/record.mjs. 510 of them, ~600MB, and
# regenerable by rerunning the script. The encoded mp4/webm are the artifact.
hero/.frames/

# Throwaway probe scripts. A stray one at the repo root fails the Oxygen
# deploy's "Uncommitted changes detected" guard, which is how a production
# deploy got refused on 2026-09-22 over a 13 line file testing buildAnswerBlock
# against two goal widgets. Name a scratch file *.tmp.mjs and it stays out of
# the way of a deploy.
*.tmp.mjs
