# Copy to .env and fill in your own values. .env is gitignored.
# Every variable, what it powers and what silently degrades without it is
# documented in app/lib/configRegistry.js. SESSION_SECRET, PUBLIC_STORE_DOMAIN
# and PUBLIC_STOREFRONT_API_TOKEN are required to render the storefront.

# --- Storefront core (required) ---
SESSION_SECRET=
PUBLIC_STORE_DOMAIN=
PUBLIC_STOREFRONT_API_TOKEN=
PUBLIC_STOREFRONT_ID=
PUBLIC_CHECKOUT_DOMAIN=
PRIVATE_ADMIN_API_TOKEN=

# --- Notifications and email ---
# Inbox that receives contact form, newsletter and free widget signup
# notifications. Falls back to the public support address when unset.
NOTIFY_EMAIL=
PRIVATE_RESEND_API_KEY=
PRIVATE_CONTACT_FROM_EMAIL=
CONTACT_CC_EMAIL=

# --- Free chat widget signup ---
PUBLIC_TURNSTILE_SITE_KEY=
PRIVATE_TURNSTILE_SECRET_KEY=
PRIVATE_FREE_CHAT_CONFIRM_SECRET=
PRIVATE_FREE_CHAT_MINT_SECRET=
PRIVATE_FREE_CHAT_TOKEN_SERVICE_URL=

# --- Digital downloads service ---
# Origin of the separate downloads service, for example https://downloads.example.com
SWS_DOWNLOADS_URL=
PRIVATE_DOWNLOADS_SERVICE_SECRET=

# --- Conversion tracking: GA4 and the Shopify orders webhook ---
PUBLIC_GA4_MEASUREMENT_ID=
PRIVATE_GA4_API_SECRET=
PRIVATE_SHOPIFY_WEBHOOK_SECRET=

# --- X ads (optional; the adapter no-ops until set) ---
PUBLIC_X_PIXEL_ID=
PUBLIC_X_EVENT_ID_PAGE_VIEW=
PUBLIC_X_EVENT_ID_VIEW_CONTENT=
PUBLIC_X_EVENT_ID_ADD_TO_CART=
PUBLIC_X_EVENT_ID_BEGIN_CHECKOUT=
PUBLIC_X_EVENT_ID_LEAD=
PRIVATE_X_PURCHASE_EVENT_ID=
# Conversion relay (preferred): full URL of a service that signs X CAPI calls
PRIVATE_X_RELAY_URL=
PRIVATE_X_RELAY_TOKEN=
# Fallbacks: a static pixel token, or OAuth 1.0a credentials
PRIVATE_X_PIXEL_TOKEN=
PRIVATE_X_CONSUMER_KEY=
PRIVATE_X_CONSUMER_SECRET=
PRIVATE_X_ACCESS_TOKEN=
PRIVATE_X_ACCESS_TOKEN_SECRET=

# --- Meta ads (optional) ---
PUBLIC_META_PIXEL_ID=
PRIVATE_META_ACCESS_TOKEN=

# --- ChatGPT Ads (optional) ---
PUBLIC_OPENAI_PIXEL_ID=
PRIVATE_OPENAI_CONVERSIONS_API_KEY=

# --- Agents, staging and admin ---
PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN=
PRIVATE_PREVIEW_PASSWORD=
PRIVATE_ADMIN_PASSWORD=

# /compatibility page status probes (server only, https URLs)
STATUS_URL_CHAT=
STATUS_URL_NOWPLAYING=
STATUS_URL_DOWNLOADS=
