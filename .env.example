# The variables added in this file are only available locally in MiniOxygen.
# Run `npx shopify hydrogen link` to also inject environment variables from your storefront,
# or `npx shopify hydrogen env pull` to populate this file.
#
# Copy this to .env and fill in real values. .env is gitignored, never commit it.

SESSION_SECRET="dev-only-secret-change-me"

# From Shopify Admin > Sales channels > Headless > (this storefront) > Storefront API
PUBLIC_STORE_DOMAIN=""
PUBLIC_STOREFRONT_API_TOKEN=""

# Browser + server analytics. Every key below is derived by one adapter
# under app/lib/analytics/pixels/ (browser) or app/lib/conversions/
# (server); see docs/analytics-setup.md for the full per-platform
# checklist of where each value comes from and where to paste it in
# production (Shopify Admin > Hydrogen > SWS Storefront > Environments and
# variables). Every adapter no-ops cleanly while its own keys are unset,
# nothing needs to be filled in to keep the site working.

# --- GA4 ---
# property "SpaceLabs - Shopify" (451083860), stream 8496264324, the same
# Measurement ID the old Online Store theme already serves on
# streamwidgetshop.com. Decided with Todd 2026-09-10, see LAUNCH.md.
PUBLIC_GA4_MEASUREMENT_ID="G-X0978HDVTK"
# GA4 Admin > Data Streams > SpaceLabs - Shopify stream > Measurement
# Protocol API secrets > Create. Server-side purchase send only (see
# app/lib/conversions/ga4.server.js).
PRIVATE_GA4_API_SECRET=""

# --- X (Twitter) ---
# Pending from Auny, tracked on Linear BAT-145. Leave all blank until she
# supplies them, every X adapter no-ops cleanly with these unset. Setting
# them here is the only change needed once the IDs arrive, no code change.
# X Ads Manager > Tools > Events Manager > (this pixel) > pixel id.
PUBLIC_X_PIXEL_ID=""
# X Ads Events Manager > the pixel's configured PageView event > Event ID.
PUBLIC_X_EVENT_ID_PAGE_VIEW=""
# X Ads Events Manager > the pixel's configured ViewContent event > Event ID.
PUBLIC_X_EVENT_ID_VIEW_CONTENT=""
# X Ads Events Manager > the pixel's configured AddToCart event > Event ID.
PUBLIC_X_EVENT_ID_ADD_TO_CART=""
# X Ads API app credentials (developer.x.com), server-side purchase send
# only (see app/lib/conversions/x.server.js). Auth scheme is UNCONFIRMED,
# see the TODO comments in that file before relying on this.
PRIVATE_X_CAPI_TOKEN=""
# X Ads Events Manager > the pixel's configured Purchase event > Event ID.
# Separate from the pixel id above, server-side purchase send only.
PRIVATE_X_PURCHASE_EVENT_ID=""

# --- Meta (Facebook/Instagram) ---
# Does not exist yet, Meta ads have not launched. Every Meta adapter
# no-ops cleanly with these unset.
# Meta Events Manager > Data Sources > (this pixel) > pixel id, shown at
# the top of the pixel's Settings tab.
PUBLIC_META_PIXEL_ID=""
# Meta Events Manager > (this pixel) > Settings > Conversions API >
# Generate access token. Server-side purchase send only (see
# app/lib/conversions/meta.server.js).
PRIVATE_META_ACCESS_TOKEN=""

# Checkout domain, passed to Hydrogen's Analytics.Provider for the Customer
# Privacy API (app/root.jsx). Shopify serves this shop's checkout from
# streamwidgetshop.com, the same registrable domain as the storefront, verified
# on 2026-09-10 by reading a real cart's checkoutUrl. That is also why GA4 can
# read the _ga cookie at checkout_completed and purchases attribute correctly,
# see docs/checkout-purchase-pixel.md. Leaving this unset does not break
# attribution, but it leaves consent handling half wired.
PUBLIC_CHECKOUT_DOMAIN="streamwidgetshop.com"

# Server-side purchase tracking (app/routes/webhooks.orders.jsx), independent
# of any browser pixel. See docs/checkout-purchase-pixel.md for why this
# exists alongside the Admin custom pixel, and its dedup note before running
# both at once. Per-platform purchase-send secrets are grouped with each
# platform's other keys above.

# Shared secret for verifying the orders/create webhook's HMAC signature.
# From Shopify Admin > Settings > Notifications > Webhooks (or the app's own
# webhook config if this shop registers webhooks through a Shopify app
# config instead). Unset means the webhook route rejects every request with
# 503, it never accepts an unverified post.
PRIVATE_SHOPIFY_WEBHOOK_SECRET=""

# Optional shared password for non production builds. When set, every request
# is gated by a simple password form (app/lib/previewGate.server.js) so a
# staging build can be opened on a phone without a Shopify login. Leave UNSET
# in production: the gate is completely inert without it.
PRIVATE_PREVIEW_PASSWORD=
