# The variables added in this file are only available locally in MiniOxygen.
# Run `npx shopify hydrogen link` to also inject environment variables from your storefront,
# or `npx shopify hydrogen env pull` to populate this file.
#
# Copy this to .env and fill in real values. .env is gitignored — never commit it.

SESSION_SECRET="dev-only-secret-change-me"

# From Shopify Admin > Sales channels > Headless > (this storefront) > Storefront API
PUBLIC_STORE_DOMAIN=""
PUBLIC_STOREFRONT_API_TOKEN=""

# Browser analytics, see app/components/pixels/GA4.jsx and XPixel.jsx.
# GA4: property "SpaceLabs - Shopify" (451083860), stream 8496264324, the
# same Measurement ID the old Online Store theme already serves on
# streamwidgetshop.com. Decided with Todd 2026-09-10, see LAUNCH.md.
PUBLIC_GA4_MEASUREMENT_ID="G-X0978HDVTK"

# X (Twitter) pixel. Pending from Auny, tracked on Linear BAT-145. Leave
# all four blank until she supplies them, the pixel component no-ops
# cleanly with any of these unset. Setting all four here is the only
# change needed once the IDs arrive, no code change.
PUBLIC_X_PIXEL_ID=""
PUBLIC_X_EVENT_ID_PAGE_VIEW=""
PUBLIC_X_EVENT_ID_VIEW_CONTENT=""
PUBLIC_X_EVENT_ID_ADD_TO_CART=""
